{
  "manifest_version": 3,
  "name": "Hush: quiet your social feeds",
  "short_name": "Hush",
  "version": "1.0.0",
  "description": "Hide Shorts, Reels, ads, suggestions and other noise on YouTube, X, Reddit, LinkedIn and Instagram. No account, no tracking.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Hush"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "src/content/youtube.ts"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "js": [
        "src/content/instagram.ts"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.twitter.com/*",
        "*://*.x.com/*"
      ],
      "js": [
        "src/content/twitter.ts"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.reddit.com/*"
      ],
      "js": [
        "src/content/reddit.ts"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.linkedin.com/*"
      ],
      "js": [
        "src/content/linkedin.ts"
      ],
      "run_at": "document_start"
    }
  ]
}
