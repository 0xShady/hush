{
  "name": "hush",
  "version": "1.0.0",
  "description": "Hide Shorts, Reels, ads, suggestions and other noise on YouTube, X, Reddit, LinkedIn and Instagram. No account, no tracking.",
  "license": "MIT",
  "author": "Achraf El Fadili (https://elfadiliachraf.tech)",
  "homepage": "https://hush-media.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xShady/hush.git"
  },
  "bugs": {
    "url": "https://github.com/0xShady/hush/issues"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "TARGET=chrome vite build",
    "build:firefox": "TARGET=firefox vite build",
    "watch:chrome": "TARGET=chrome vite build --watch",
    "watch:firefox": "TARGET=firefox vite build --watch",
    "dev:chrome": "DEV_RELOAD=1 TARGET=chrome vite build --watch",
    "start:chrome": "web-ext run -s dist/chrome -t chromium --chromium-profile ~/.local/share/hush/chrome-profile --profile-create-if-missing --keep-profile-changes --start-url https://youtube.com",
    "start:firefox": "web-ext run -s dist/firefox --firefox-profile ~/.local/share/hush/firefox-profile --profile-create-if-missing --keep-profile-changes --start-url https://youtube.com",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && npm run package:chrome && npm run package:firefox",
    "package:chrome": "web-ext build -s dist/chrome -a web-ext-artifacts/chrome --filename hush-chrome-{version}.zip --ignore-files dev-build.json --overwrite-dest",
    "package:firefox": "web-ext build -s dist/firefox -a web-ext-artifacts/firefox --filename hush-firefox-{version}.zip --overwrite-dest",
    "lint:firefox": "web-ext lint -s dist/firefox",
    "release": "sh scripts/release.sh",
    "lint": "eslint ."
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@samrum/vite-plugin-web-extension": "^5.1.1",
    "@types/webextension-polyfill": "^0.12.1",
    "eslint": "^9.39.4",
    "globals": "^17.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "web-ext": "^10.8.0"
  },
  "overrides": {
    "@samrum/vite-plugin-web-extension": {
      "vite": "$vite",
      "content-security-policy-parser": "^0.6.0"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
